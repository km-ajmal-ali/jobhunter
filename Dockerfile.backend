# =============================================================================
# Dockerfile for JobHunter Backend (FastAPI + APScheduler)
#
# Uses python:3.12-slim for a small footprint.
# Installs Playwright system deps for JS-heavy scraper targets.
# =============================================================================

FROM python:3.12-slim

# ── Environment ─────────────────────────────────────────────────────────────
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# ── System dependencies ─────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

# ── Python dependencies ─────────────────────────────────────────────────────
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# ── Application code ────────────────────────────────────────────────────────
COPY backend/ .

# ── Runtime ─────────────────────────────────────────────────────────────────
EXPOSE 8000

# Run with uvicorn. Use multiple workers for production.
# APScheduler runs in the main process alongside the API.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
