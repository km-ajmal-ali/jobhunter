# =============================================================================
# JobHunter Environment Configuration
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit the .env file to git. It contains secrets.
# =============================================================================

# ── Database ────────────────────────────────────────────────────────────────
DB_USER=jobuser
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=jobhunter

# ── Backend ─────────────────────────────────────────────────────────────────
DEBUG=false

# Comma-separated allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost,http://YOUR_SERVER_IP

# Scraping schedule hours (UTC)
SCRAPER_TIER1_SCHEDULE_HOUR=2
SCRAPER_TIER2_ENABLED=false
SCRAPER_TIER2_SCHEDULE_HOUR=3

# Optional: comma-separated proxy list for Tier 2 scrapers
# PROXY_LIST=http://proxy1:8080,http://proxy2:8080

# ── GitHub Container Registry ───────────────────────────────────────────────
# Your GitHub username or org for GHCR image tags
GHCR_OWNER=your-github-username

# ── VPS Deployment ─────────────────────────────────────────────────────────
# SSH connection string for the deploy workflow
SSH_HOST=your-server-ip
SSH_USER=root
SSH_PORT=22
